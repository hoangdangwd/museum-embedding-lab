# local or openrouter
EMBEDDING_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-embedding-2
# Change this tag to invalidate cached vectors after a provider/model update.
EMBEDDING_VERSION=1
LOCAL_MODEL=google/siglip2-base-patch16-224
LOCAL_REVISION=main
# cpu or cuda; default cpu works without a GPU.
LOCAL_DEVICE=cpu
