OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-embedding-2
RECOGNITION_PIPELINE=image-description-v1
DESCRIPTION_MODEL=google/gemini-2.5-flash
# Backend-only secret, at least 32 characters. Never put this in a VITE_* variable.
RECOGNITION_SERVICE_TOKEN=
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=
ALLOW_ADMIN_LOCAL=false
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=2
PREPROCESS_VERSION=rgb-exif-white-jpeg95-max1600-v1
RECOGNITION_THRESHOLD=0.8
RECOGNITION_MARGIN=0.05
DAILY_EMBEDDING_LIMIT=200
