{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "museum-embedding-lab",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-23",
	"workers_dev": true,
	"triggers": { "crons": ["0 3 * * *"] },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "museum-embedding-lab",
			"database_id": "e977cf35-e200-49ad-b016-898977fcc99e",
			"migrations_dir": "./migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "museum-embedding-images",
		},
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "museum-embedding-1536",
			"remote": true,
		},
	],
	"vars": {
		"RECOGNITION_PIPELINE": "image-description-v1",
		"DESCRIPTION_MODEL": "google/gemini-2.5-flash",
		"ALLOW_ADMIN_PUBLIC": "true",
		"ACCESS_TEAM_DOMAIN": "spring-bonus-99a8.cloudflareaccess.com",
		"ACCESS_AUD": "d722fd12ef1eeee236a606fc9871f33cadd2f51ca3090eda382c40570f55187b",
		"OPENROUTER_MODEL": "google/gemini-embedding-2",
		"EMBEDDING_DIMENSIONS": "1536",
		"EMBEDDING_VERSION": "1",
		"PREPROCESS_VERSION": "rgb-exif-white-jpeg95-max1600-v1",
		"RECOGNITION_THRESHOLD": "0.8",
		"RECOGNITION_MARGIN": "0.05",
		"RECOGNITION_HARD_NEGATIVE_GAP": "-0.009",
				"DAILY_EMBEDDING_LIMIT": "100000",
		"JEV_MODE": "off",
		"JEV_IMAGE_PROCESSOR": "remote",
		"JEV_NORMALIZER_TIMEOUT_MS": "5000",
		"JEV_DAILY_LIMIT": "100000",
		"JEV_DAILY_BUDGET_MICROUSD": "5000000",
		"JEV_MAX_CONCURRENCY": "2",
		"JEV_TIMEOUT_MS": "5000",
	},
	"env": {
		"dev": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "museum-embedding-lab",
					"database_id": "e977cf35-e200-49ad-b016-898977fcc99e",
					"migrations_dir": "./migrations"
				}
			],
			"r2_buckets": [
				{ "binding": "IMAGES", "bucket_name": "museum-embedding-images" }
			],
			"vectorize": [
				{ "binding": "VECTORIZE", "index_name": "museum-embedding-1536-dev", "remote": true }
			],
			"vars": {
				"RECOGNITION_PIPELINE": "image-description-v1",
				"DESCRIPTION_MODEL": "google/gemini-2.5-flash",
				"ALLOW_ADMIN_LOCAL": "true",
				"OPENROUTER_MODEL": "google/gemini-embedding-2",
				"EMBEDDING_DIMENSIONS": "1536",
				"EMBEDDING_VERSION": "1",
				"PREPROCESS_VERSION": "rgb-exif-white-jpeg95-max1600-v1",
				"RECOGNITION_THRESHOLD": "0.8",
				"RECOGNITION_MARGIN": "0.05",
				"RECOGNITION_HARD_NEGATIVE_GAP": "-0.08",
				"DAILY_EMBEDDING_LIMIT": "30",
				"JEV_MODE": "off",
				"JEV_IMAGE_PROCESSOR": "remote",
				"JEV_NORMALIZER_TIMEOUT_MS": "5000"
			}
		}
	}
}
